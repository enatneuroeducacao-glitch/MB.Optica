model LegacyRecord {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  source String @default("BEEPSTART")
  collectionKey String?
  legacyId String?
  legacyKey String @unique
  payload Json
  customerId String?
  migrationRunId String?
  targetEntity String?
  targetId String?
  status String @default("PRESERVED")
  errorMessage String?
  importedAt DateTime @default(now())
  customer Customer? @relation(fields:[customerId],references:[id])
  migrationRun MigrationRun? @relation(fields:[migrationRunId],references:[id])
  @@index([collectionKey])
  @@index([legacyId])
  @@index([migrationRunId])
  @@index([targetEntity,targetId])
}
enum PayrollRecordType {
  PROLABORE
  SALARIO
}

enum PayrollStatus {
  RASCUNHO
  EMITIDA
  PAGA
  CANCELADA
}

