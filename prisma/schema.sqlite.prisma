cardInstallments Int?
cardFeeRate Decimal?
cardFeeAmount Decimal?
cardNetAmount Decimal?
reversedAt DateTime?
reversalReference String?
paidAt DateTime @default(now())
accountSettlementId String? @unique
sale Sale @relation(fields:[saleId],references:[id],onDelete:Cascade)
method PaymentMethod @relation(fields:[methodId],references:[id])
cardMachine CardMachine? @relation(fields:[cardMachineId],references:[id])
accountSettlement AccountSettlement? @relation(fields:[accountSettlementId],references:[id])
}
model Account {
  organizationId String? // Nullable during the additive multi-tenant rollout.
id String @id @default(cuid())
type AccountType
classification String @default("OUTRA_OBRIGACAO")
description String
customerId String?
supplierId String?
saleId String?
dueDate DateTime
amount Decimal
paidAmount Decimal @default(0)
status PaymentStatus @default(PENDENTE)
notes String?
  writtenOffAt DateTime?
  writtenOffReason String?
customer Customer? @relation(fields:[customerId],references:[id])
supplier Supplier? @relation(fields:[supplierId],references:[id])
sale Sale? @relation(fields:[saleId],references:[id])
settlements AccountSettlement[]
}
model AccountSettlement {
id String @id @default(cuid())
accountId String
amount Decimal
paidAt DateTime @default(now())
method String?
methodId String?
cardMachineId String?
cardInstallments Int?
cardFeeRate Decimal?
cardFeeAmount Decimal?
cardNetAmount Decimal?
reference String?
notes String?
reversedAt DateTime?
account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
paymentMethod PaymentMethod? @relation(fields:[methodId],references:[id])
cardMachine CardMachine? @relation(fields:[cardMachineId],references:[id])
payment Payment?
@@index([accountId,paidAt])
}
model CashSession {
  organizationId String? // Nullable during the additive multi-tenant rollout.
id String @id @default(cuid())
openedAt DateTime @default(now())
closedAt DateTime?
openingCash Decimal
closingCash Decimal?
notes String?
movements CashMovement[]
}
model CashMovement {
id String @id @default(cuid())
sessionId String
kind String
amount Decimal
description String
referenceId String?
createdAt DateTime @default(now())
session CashSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
}
