}

model CardMachine {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  settlements AccountSettlement[]
}

model PixKey {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  type String
  key String @unique
  holderName String
  holderDocument String?
  city String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Payment {
id String @id @default(cuid())
saleId String
methodId String
amount Decimal
reference String?
