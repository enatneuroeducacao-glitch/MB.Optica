generator client {
provider = "prisma-client-js"
}
datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
directUrl = env("DIRECT_URL")
}
enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  LABORATORIO
  FINANCEIRO
}
enum OrderStatus {
  ORCAMENTO
  APROVADO
  PEDIDO
  AGUARDANDO_LABORATORIO
  EM_PRODUCAO
  RECEBIDO
  CONFERENCIA
  RETORNO_GARANTIA
  PRONTO
  ENTREGUE
  CANCELADO
  DEVOLVIDO
}
enum PaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}
enum AccountType {
  RECEBER
  PAGAR
}
enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCAO
}
enum FiscalDocumentType {
  NFC_E
  NF_E
  NFA_E
  NFS_E
}
enum FiscalDocumentStatus {
  PENDENTE
  AUTORIZADO
  REJEITADO
  CANCELADO
  INUTILIZADO
  CONTINGENCIA
}
enum FiscalIntegrationMode {
  NFF
  NFAE_SAT
  PAF_NFCE
  MANUAL
}
model FiscalConfig {
id String @id @default(cuid())
  legalName String?
  tradeName String?
  cnpj String?
  stateRegistration String?
  municipalRegistration String?
  uf String @default("SC")
  city String?
  taxRegime String @default("SIMEI")
  integrationMode FiscalIntegrationMode @default(NFF)
  series String?
  environment String @default("HOMOLOGACAO")
  secretReference String?
  certificateType String?
  certificateExpiresAt DateTime?
  certificateAuthority String?
  certificateLastCheckedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents FiscalDocument[]
}
model FiscalDocument {
id String @id @default(cuid())
  type FiscalDocumentType
  status FiscalDocumentStatus @default(PENDENTE)
  number String?
  series String?
  accessKey String?
  protocol String?
  issueDate DateTime?
  authorizationDate DateTime?
  cancellationDate DateTime?
  total Decimal @default(0) @db.Decimal(12,2)
  customerName String?
  customerDocument String?
  xml String?
  danfeUrl String?
  qrCodeUrl String?
  rejectionCode String?
  rejectionMessage String?
  notes String?
  configId String?
  saleId String? @unique
  config FiscalConfig? @relation(fields:[configId],references:[id])
  sale Sale? @relation(fields:[saleId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([accessKey])
}
enum SubscriptionPlan {
  BASICO
  PROFISSIONAL
  PREMIUM
  ENTERPRISE
  PROPRIETARIO
}

enum SubscriptionStatus {
  AVALIACAO
  ATIVA
  PENDENTE
  SUSPENSA
  CANCELADA
  EXPIRADA
}

enum BillingCycle {
  MENSAL
  ANUAL
}

model Subscription {
  id String @id @default(cuid())
  plan SubscriptionPlan @default(PROFISSIONAL)
  status SubscriptionStatus @default(AVALIACAO)
  billingCycle BillingCycle @default(MENSAL)
  price Decimal @default(0) @db.Decimal(12,2)
  maxUsers Int @default(5)
  maxUnits Int?
  maxClients Int?
  maxProducts Int?
  maxSales Int?
  maxOrders Int?
  trialDays Int @default(15)
  graceDays Int @default(5)
  licenseType String @default("SUBSCRIPTION")
  modules Json?
  provider String?
  providerCustomerId String?
  providerSubscriptionId String? @unique
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([currentPeriodEnd])
}

model User {
id String @id @default(cuid())
name String
email String @unique
mbEmail String? @unique
role UserRole @default(VENDEDOR)
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
passwordHash String?
mustChangePassword Boolean @default(false)
sessionVersion Int @default(0)
lastLoginAt DateTime?
permissions Json?
passwordResetTokens PasswordResetToken[]
sales Sale[]
orders OpticalOrder[]
quotes Quote[]
auditLogs AuditLog[]
  mailStates MailMessageState[]
  mailContactPreferences MailContactPreference[]
}

model MailMessageState {
  id String @id @default(cuid())
  userId String
  messageId String
  read Boolean @default(false)
  archived Boolean @default(false)
  deleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,messageId])
  @@index([userId,archived,deleted])
}

model MailContactPreference {
  id String @id @default(cuid())
  userId String
  email String
  contactType String
  hidden Boolean @default(false)
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,email])
  @@index([userId,contactType,hidden])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
}

model Customer {
id String @id @default(cuid())
name String
cpfCnpj String? @unique
phone String?
whatsapp String?
email String?
birthDate DateTime?
notes String?
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
addresses Address[]
prescriptions Prescription[]
quotes Quote[]
orders OpticalOrder[]
sales Sale[]
accounts Account[]
legacyRecords LegacyRecord[]
appointments Appointment[]
thirdPartyFrameIntakes ThirdPartyFrameIntake[]
}
model Address {
id String @id @default(cuid())
customerId String
label String?
street String?
number String?
complement String?
district String?
city String?
state String?
postalCode String?
customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
}
model Prescription {
id String @id @default(cuid())
customerId String
date DateTime @default(now())
professional String?
validUntil DateTime?
odSphere Decimal? @db.Decimal(6,2)
odCylinder Decimal? @db.Decimal(6,2)
odAxis Decimal? @db.Decimal(6,2)
odAdd Decimal? @db.Decimal(6,2)
odPrism Decimal? @db.Decimal(6,2)
odBase String?
odDnp Decimal? @db.Decimal(6,2)
odHeight Decimal? @db.Decimal(6,2)
oeSphere Decimal? @db.Decimal(6,2)
oeCylinder Decimal? @db.Decimal(6,2)
oeAxis Decimal? @db.Decimal(6,2)
oeAdd Decimal? @db.Decimal(6,2)
oePrism Decimal? @db.Decimal(6,2)
oeBase String?
oeDnp Decimal? @db.Decimal(6,2)
oeHeight Decimal? @db.Decimal(6,2)
pdTotal Decimal? @db.Decimal(6,2)
notes String?
originalText String?
customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
orders OpticalOrder[]
quotes Quote[]
}
model Category {
id String @id @default(cuid())
name String @unique
active Boolean @default(true)
products Product[]
}
model Supplier {
id String @id @default(cuid())
name String
document String?
phone String?
email String?
notes String?
active Boolean @default(true)
products Product[]
accounts Account[]
}
model Product {
id String @id @default(cuid())
ncm String?
cest String?
cfop String?
origin String?
taxCode String?
code String @unique
barcode String? @unique
description String
brand String?
model String?
color String?
frameSize String?
lensWidth Int?
bridgeWidth Int?
templeLength Int?
material String?
frameShape String?
photoData String?
publishedOnSite Boolean @default(false)
siteCollectionSlug String?
siteFeatured Boolean @default(false)
siteSortOrder Int @default(0)
siteDescription String?
sitePrice Decimal? @db.Decimal(12,2)
siteProductId String?
siteSyncedAt DateTime?
siteSyncStatus String?
siteSyncError String?
unit String @default("UN")
cost Decimal @default(0) @db.Decimal(12,2)
salePrice Decimal @default(0) @db.Decimal(12,2)
minimumStock Decimal @default(0) @db.Decimal(12,3)
stockControlled Boolean @default(true)
active Boolean @default(true)
categoryId String?
supplierId String?
category Category? @relation(fields:[categoryId],references:[id])
supplier Supplier? @relation(fields:[supplierId],references:[id])
lots StockLot[]
movements StockMovement[]
orderItems OpticalOrderItem[]
quoteItems QuoteItem[]
saleItems SaleItem[]
}
model StockLot {
id String @id @default(cuid())
productId String
code String?
description String?
receivedAt DateTime @default(now())
quantity Decimal @db.Decimal(12,3)
cost Decimal? @db.Decimal(12,2)
expiresAt DateTime?
archived Boolean @default(false)
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
movementLots StockMovementLot[]
}
model StockMovement {
id String @id @default(cuid())
productId String
type StockMovementType
quantity Decimal @db.Decimal(12,3)
unitCost Decimal? @db.Decimal(12,2)
reference String?
referenceId String?
notes String?
createdAt DateTime @default(now())
product Product @relation(fields:[productId],references:[id])
lotLinks StockMovementLot[]
}
model StockMovementLot {
id String @id @default(cuid())
movementId String
lotId String
quantity Decimal @db.Decimal(12,3)
movement StockMovement @relation(fields:[movementId],references:[id],onDelete:Cascade)
lot StockLot @relation(fields:[lotId],references:[id])
@@unique([movementId,lotId])
@@index([lotId])
}
model Quote {
id String @id @default(cuid())
number Int @unique @default(autoincrement())
customerId String
prescriptionId String?
sellerId String?
status String @default("ABERTO")
validUntil DateTime?
deliveryDate DateTime?
discount Decimal @default(0) @db.Decimal(12,2)
surcharge Decimal @default(0) @db.Decimal(12,2)
entryAmount Decimal @default(0) @db.Decimal(12,2)
total Decimal @default(0) @db.Decimal(12,2)
paymentMethod String?
installments Int?
notes String?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
customer Customer @relation(fields:[customerId],references:[id])
prescription Prescription? @relation(fields:[prescriptionId],references:[id])
seller User? @relation(fields:[sellerId],references:[id])
items QuoteItem[]
order OpticalOrder?
@@index([status])
@@index([customerId,createdAt])
}
model QuoteItem {
id String @id @default(cuid())
quoteId String
productId String?
description String
kind String?
eye String?
quantity Decimal @db.Decimal(12,3)
unitPrice Decimal @db.Decimal(12,2)
quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
product Product? @relation(fields:[productId],references:[id])
}
model OpticalOrder {
id String @id @default(cuid())
number Int @unique @default(autoincrement())
customerId String
prescriptionId String?
sellerId String?
status OrderStatus @default(ORCAMENTO)
dueDate DateTime?
laboratory String?
laboratorySentAt DateTime?
receivedAt DateTime?
deliveredAt DateTime?
notes String?
total Decimal @default(0) @db.Decimal(12,2)
discount Decimal @default(0) @db.Decimal(12,2)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
customer Customer @relation(fields:[customerId],references:[id])
prescription Prescription? @relation(fields:[prescriptionId],references:[id])
seller User? @relation(fields:[sellerId],references:[id])
items OpticalOrderItem[]
events OrderEvent[]
quoteId String? @unique
quote Quote? @relation(fields:[quoteId],references:[id])
sale Sale?
}
model OpticalOrderItem {
id String @id @default(cuid())
orderId String
productId String?
description String
kind String
eye String?
quantity Decimal @default(1) @db.Decimal(12,3)
unitPrice Decimal @default(0) @db.Decimal(12,2)
order OpticalOrder @relation(fields:[orderId],references:[id],onDelete:Cascade)
product Product? @relation(fields:[productId],references:[id])
}
model OrderEvent {
id String @id @default(cuid())
orderId String
status OrderStatus
message String
createdAt DateTime @default(now())
order OpticalOrder @relation(fields:[orderId],references:[id])
}
model Sale {
id String @id @default(cuid())
number Int @unique @default(autoincrement())
customerId String?
sellerId String
saleType String @default("BALCAO")
orderId String? @unique
subtotal Decimal @default(0) @db.Decimal(12,2)
discount Decimal @default(0) @db.Decimal(12,2)
surcharge Decimal @default(0) @db.Decimal(12,2)
total Decimal @default(0) @db.Decimal(12,2)
notes String?
paymentCondition String?
installments Int?
pixPayload String?
canceled Boolean @default(false)
canceledAt DateTime?
cancelReason String?
createdAt DateTime @default(now())
customer Customer? @relation(fields:[customerId],references:[id])
seller User @relation(fields:[sellerId],references:[id])
order OpticalOrder? @relation(fields:[orderId],references:[id])
items SaleItem[]
payments Payment[]
accounts Account[]
fiscalDocument FiscalDocument?
}
model SaleItem {
id String @id @default(cuid())
saleId String
productId String?
description String
quantity Decimal @db.Decimal(12,3)
unitPrice Decimal @db.Decimal(12,2)
unitCost Decimal @default(0) @db.Decimal(12,2)
discount Decimal @default(0) @db.Decimal(12,2)
total Decimal @default(0) @db.Decimal(12,2)
sale Sale @relation(fields:[saleId],references:[id],onDelete:Cascade)
product Product? @relation(fields:[productId],references:[id])
}
model PaymentMethod {
id String @id @default(cuid())
name String @unique
active Boolean @default(true)
isCash Boolean @default(true)
payments Payment[]
settlements AccountSettlement[]
accountingMappings AccountingMapping[]
}

model CardMachine {
  id String @id @default(cuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  settlements AccountSettlement[]
}

model PixKey {
  id String @id @default(cuid())
  type String
  key String @unique
  holderName String
  holderDocument String?
  city String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Payment {
id String @id @default(cuid())
saleId String
methodId String
amount Decimal @db.Decimal(12,2)
reference String?
cardMachineId String?
cardInstallments Int?
cardFeeRate Decimal? @db.Decimal(5,2)
cardFeeAmount Decimal? @db.Decimal(12,2)
cardNetAmount Decimal? @db.Decimal(12,2)
reversedAt DateTime?
reversalReference String?
paidAt DateTime @default(now())
accountSettlementId String? @unique
sale Sale @relation(fields:[saleId],references:[id],onDelete:Cascade)
method PaymentMethod @relation(fields:[methodId],references:[id])
cardMachine CardMachine? @relation(fields:[cardMachineId],references:[id])
accountSettlement AccountSettlement? @relation(fields:[accountSettlementId],references:[id])
}
model Account {
id String @id @default(cuid())
type AccountType
classification String @default("OUTRA_OBRIGACAO")
description String
customerId String?
supplierId String?
saleId String?
dueDate DateTime
amount Decimal @db.Decimal(12,2)
paidAmount Decimal @default(0) @db.Decimal(12,2)
status PaymentStatus @default(PENDENTE)
notes String?
  writtenOffAt DateTime?
  writtenOffReason String?
customer Customer? @relation(fields:[customerId],references:[id])
supplier Supplier? @relation(fields:[supplierId],references:[id])
sale Sale? @relation(fields:[saleId],references:[id])
settlements AccountSettlement[]
}
model AccountSettlement {
id String @id @default(cuid())
accountId String
amount Decimal @db.Decimal(12,2)
paidAt DateTime @default(now())
method String?
methodId String?
cardMachineId String?
cardInstallments Int?
cardFeeRate Decimal? @db.Decimal(5,2)
cardFeeAmount Decimal? @db.Decimal(12,2)
cardNetAmount Decimal? @db.Decimal(12,2)
reference String?
notes String?
reversedAt DateTime?
account Account @relation(fields:[accountId],references:[id],onDelete:Cascade)
paymentMethod PaymentMethod? @relation(fields:[methodId],references:[id])
cardMachine CardMachine? @relation(fields:[cardMachineId],references:[id])
payment Payment?
@@index([accountId,paidAt])
}
model CashSession {
id String @id @default(cuid())
openedAt DateTime @default(now())
closedAt DateTime?
openingCash Decimal @db.Decimal(12,2)
closingCash Decimal? @db.Decimal(12,2)
notes String?
movements CashMovement[]
}
model CashMovement {
id String @id @default(cuid())
sessionId String
kind String
amount Decimal @db.Decimal(12,2)
description String
referenceId String?
createdAt DateTime @default(now())
session CashSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
}
model AuditLog {
id String @id @default(cuid())
userId String?
action String
entity String
entityId String?
metadata Json?
createdAt DateTime @default(now())
user User? @relation(fields:[userId],references:[id])
}
model MigrationRun {
  id String @id @default(cuid())
  source String
  sourceFingerprint String @unique
  status String @default("RUNNING")
  total Int
  imported Int @default(0)
  mapped Int @default(0)
  warnings Int @default(0)
  errors Int @default(0)
  report Json?
  startedAt DateTime @default(now())
  completedAt DateTime?
  legacyRecords LegacyRecord[]
}
model LegacyRecord {
  id String @id @default(cuid())
  source String @default("BEEPSTART")
  collectionKey String?
  legacyId String?
  legacyKey String @unique
  payload Json
  customerId String?
  migrationRunId String?
  targetEntity String?
  targetId String?
  status String @default("PRESERVED")
  errorMessage String?
  importedAt DateTime @default(now())
  customer Customer? @relation(fields:[customerId],references:[id])
  migrationRun MigrationRun? @relation(fields:[migrationRunId],references:[id])
  @@index([collectionKey])
  @@index([legacyId])
  @@index([migrationRunId])
  @@index([targetEntity,targetId])
}
enum PayrollRecordType {
  PROLABORE
  SALARIO
}

enum PayrollStatus {
  RASCUNHO
  EMITIDA
  PAGA
  CANCELADA
}

model PayrollSettings {
  id String @id @default(cuid())
  ownerName String @default("Moni Becker")
  ownerRole String @default("Proprietária / Administradora")
  recommendationMode String @default("MEDIA_6_MESES")
  reservePercent Decimal @default(10) @db.Decimal(5,2)
  salaryRules Json
  taxRules Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayrollRecord {
  id String @id @default(cuid())
  competence DateTime
  personName String
  role String?
  type PayrollRecordType @default(PROLABORE)
  grossAmount Decimal @db.Decimal(12,2)
  inssAmount Decimal @default(0) @db.Decimal(12,2)
  irrfAmount Decimal @default(0) @db.Decimal(12,2)
  otherDiscounts Decimal @default(0) @db.Decimal(12,2)
  netAmount Decimal @db.Decimal(12,2)
  employerInss Decimal @default(0) @db.Decimal(12,2)
  fgtsAmount Decimal @default(0) @db.Decimal(12,2)
  totalCost Decimal @db.Decimal(12,2)
  status PayrollStatus @default(RASCUNHO)
  paymentDate DateTime?
  notes String?
  ruleSnapshot Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([competence])
  @@index([personName,competence])
  @@index([status])
}

model StoreSettings {
  id String @id @default(cuid())
  legalName String?
  tradeName String @default("MB Óptica")
  logoData String?
  document String?
  phone String?
  whatsapp String?
  email String?
  street String?
  number String?
  complement String?
  district String?
  city String?
  state String? @default("SC")
  postalCode String?
  timezone String @default("America/Sao_Paulo")
  currency String @default("BRL")
  shiftStartTime String @default("09:00")
  shiftEndTime String @default("18:00")
  timeTrackingEnabled Boolean @default(true)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Appointment {
  id String @id @default(cuid())
  customerId String
  type String
  professionalType String
  professionalName String
  scheduledAt DateTime
  status String @default("AGENDADO")
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
  @@index([scheduledAt])
  @@index([customerId,scheduledAt])
}
model ServiceOrderSequence {
  id String @id
  nextNumber Int @default(1)
  updatedAt DateTime @updatedAt
}

// Accounting foundation — double-entry bookkeeping. Operational modules remain the source of business events.
model AccountingSettings {
  id String @id @default(cuid())
  taxRegime String @default("SIMPLES_NACIONAL")
  accountingStartDate DateTime?
  currency String @default("BRL")
  timezone String @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChartOfAccount {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  nature String
  accountType String
  parentId String?
  active Boolean @default(true)
  system Boolean @default(false)
  parent ChartOfAccount? @relation("AccountingAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ChartOfAccount[] @relation("AccountingAccountTree")
  lines AccountingEntryLine[]
  debitMappings AccountingMapping[] @relation("AccountingMappingDebit")
  creditMappings AccountingMapping[] @relation("AccountingMappingCredit")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId])
  @@index([active, nature])
}

model AccountingPeriod {
  id String @id @default(cuid())
  year Int
  month Int
  startDate DateTime
  endDate DateTime
  status String @default("ABERTO")
  closedAt DateTime?
  closedByUserId String?
  notes String?
  entries AccountingEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([year, month])
  @@index([status, startDate, endDate])
}

model AccountingEntry {
  id String @id @default(cuid())
  entryDate DateTime
  competenceDate DateTime
  description String
  sourceType String @default("MANUAL")
  sourceId String?
  originKey String? @unique
  status String @default("RASCUNHO")
  totalDebit Decimal @default(0) @db.Decimal(14,2)
  totalCredit Decimal @default(0) @db.Decimal(14,2)
  periodId String
  period AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines AccountingEntryLine[]
  sourceEvent AccountingEvent?
  createdByUserId String?
  postedAt DateTime?
  reversedAt DateTime?
  reversalOfId String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([entryDate])
  @@index([competenceDate])
  @@index([periodId, status])
  @@index([sourceType, sourceId])
}

model AccountingEntryLine {
  id String @id @default(cuid())
  entryId String
  accountId String
  lineNumber Int
  description String?
  debit Decimal @default(0) @db.Decimal(14,2)
  credit Decimal @default(0) @db.Decimal(14,2)
  referenceType String?
  referenceId String?
  entry AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([entryId, lineNumber])
  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model AccountingMapping {
  id String @id @default(cuid())
  eventType String
  paymentMethodId String?
  debitAccountId String
  creditAccountId String
  active Boolean @default(true)
  description String?
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  debitAccount ChartOfAccount @relation("AccountingMappingDebit", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount ChartOfAccount @relation("AccountingMappingCredit", fields: [creditAccountId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventType, paymentMethodId, debitAccountId, creditAccountId])
  @@index([eventType, paymentMethodId, active])
}

model AccountingEvent {
  id String @id @default(cuid())
  eventType String
  sourceType String
  sourceId String
  idempotencyKey String @unique
  payload Json?
  status String @default("PENDENTE")
  processedAt DateTime?
  errorMessage String?
  entryId String? @unique
  entry AccountingEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventType, status])
  @@index([sourceType, sourceId])
}

model ThirdPartyFrameIntake {
  id String @id @default(cuid())
  customerName String
  customerId String?
  brand String?
  model String?
  source String @default("MARKETPLACE")
  purchaseDate DateTime?
  condition String
  risks String?
  serviceRequested String
  inspectionNotes String?
  photoReferences String?
  customerAcknowledged Boolean @default(false)
  servicePrice Decimal? @db.Decimal(12,2)
  status String @default("RECEBIDA")
  createdByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([customerId])
}
