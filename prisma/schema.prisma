generator client {
provider = "prisma-client-js"
}
datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
directUrl = env("DIRECT_URL")
}
enum UserRole {
  ADMIN
  GERENTE
  VENDEDOR
  LABORATORIO
  FINANCEIRO
}
enum OrderStatus {
  ORCAMENTO
  APROVADO
  PEDIDO
  AGUARDANDO_LABORATORIO
  EM_PRODUCAO
  RECEBIDO
  CONFERENCIA
  RETORNO_GARANTIA
  PRONTO
  ENTREGUE
  CANCELADO
  DEVOLVIDO
}
enum PaymentStatus {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}
enum AccountType {
  RECEBER
  PAGAR
}
enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCAO
}
enum FiscalDocumentType {
  NFC_E
  NF_E
  NFA_E
  NFS_E
}
enum FiscalDocumentStatus {
  PENDENTE
  AUTORIZADO
  REJEITADO
  CANCELADO
  INUTILIZADO
  CONTINGENCIA
}
enum FiscalIntegrationMode {
  NFF
  NFAE_SAT
  PAF_NFCE
  MANUAL
}
model FiscalConfig {
  organizationId String? // Nullable during the additive multi-tenant rollout.
id String @id @default(cuid())
  legalName String?
  tradeName String?
  cnpj String?
  stateRegistration String?
  municipalRegistration String?
  uf String @default("SC")
  city String?
  taxRegime String @default("SIMEI")
  integrationMode FiscalIntegrationMode @default(NFF)
  series String?
  environment String @default("HOMOLOGACAO")
  secretReference String?
  certificateType String?
  certificateExpiresAt DateTime?
  certificateAuthority String?
  certificateLastCheckedAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents FiscalDocument[]
  @@unique([id, organizationId])
}
model FiscalDocument {
  organizationId String? // Nullable during the additive multi-tenant rollout.
id String @id @default(cuid())
  type FiscalDocumentType
  status FiscalDocumentStatus @default(PENDENTE)
  number String?
  series String?
  accessKey String?
  protocol String?
  issueDate DateTime?
  authorizationDate DateTime?
  cancellationDate DateTime?
  total Decimal @default(0) @db.Decimal(12,2)
  customerName String?
  customerDocument String?
  xml String?
  danfeUrl String?
  qrCodeUrl String?
  rejectionCode String?
  rejectionMessage String?
  notes String?
  configId String?
  saleId String? @unique
  config FiscalConfig? @relation(fields: [configId, organizationId],references: [id, organizationId])
  sale Sale? @relation(fields: [saleId, organizationId],references: [id, organizationId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([accessKey])
  @@unique([id, organizationId])
  @@unique([saleId, organizationId])
}
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  OWNER
  SUPER_ADMIN
  SUPPORT
}

enum SubscriptionPlan {
  BASICO
  PROFISSIONAL
  PREMIUM
  ENTERPRISE
  PROPRIETARIO
}

enum SubscriptionStatus {
  AVALIACAO
  ATIVA
  PENDENTE
  SUSPENSA
  CANCELADA
  EXPIRADA
}

enum BillingCycle {
  MENSAL
  ANUAL
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  status OrganizationStatus @default(ACTIVE)
  timezone String @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships OrganizationMembership[]
  subscription Subscription?
  @@index([status, createdAt])
}

model OrganizationMembership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role UserRole @default(VENDEDOR)
  active Boolean @default(true)
  permissions Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId, active])
  @@index([organizationId, role, active])
}

model PlatformAccess {
  id String @id @default(cuid())
  userId String @unique
  role PlatformRole @default(OWNER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([role, active])
}

model Subscription {
  id String @id @default(cuid())
  organizationId String? @unique
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @default(PROFISSIONAL)
  status SubscriptionStatus @default(AVALIACAO)
  billingCycle BillingCycle @default(MENSAL)
  price Decimal @default(0) @db.Decimal(12,2)
  maxUsers Int @default(5)
  maxUnits Int?
  maxClients Int?
  maxProducts Int?
  maxSales Int?
  maxOrders Int?
  trialDays Int @default(60)
  graceDays Int @default(5)
  licenseType String @default("SUBSCRIPTION")
  modules Json?
  provider String?
  providerCustomerId String?
  providerSubscriptionId String? @unique
  trialEndsAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
  @@index([currentPeriodEnd])
  @@unique([id, organizationId])
}

model User {
id String @id @default(cuid())
name String
email String @unique
mbEmail String? @unique
role UserRole @default(VENDEDOR)
active Boolean @default(true)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
passwordHash String?
mustChangePassword Boolean @default(false)
sessionVersion Int @default(0)
lastLoginAt DateTime?
permissions Json?
passwordResetTokens PasswordResetToken[]
sales Sale[]
orders OpticalOrder[]
quotes Quote[]
auditLogs AuditLog[]
  memberships OrganizationMembership[]
  platformAccess PlatformAccess?
  mailStates MailMessageState[]
  mailContactPreferences MailContactPreference[]
}

model MailMessageState {
  id String @id @default(cuid())
  userId String
  messageId String
  read Boolean @default(false)
  archived Boolean @default(false)
  deleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,messageId])
  @@index([userId,archived,deleted])
}

model MailContactPreference {
  id String @id @default(cuid())
  userId String
  email String
  contactType String
  hidden Boolean @default(false)
  deleted Boolean @default(false)
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,email])
  @@index([userId,contactType,hidden])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
}

