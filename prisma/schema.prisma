// Accounting foundation — double-entry bookkeeping. Operational modules remain the source of business events.
model AccountingSettings {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  taxRegime String @default("SIMPLES_NACIONAL")
  accountingStartDate DateTime?
  currency String @default("BRL")
  timezone String @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, organizationId])
}

model ChartOfAccount {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  nature String
  accountType String
  parentId String?
  active Boolean @default(true)
  system Boolean @default(false)
  parent ChartOfAccount? @relation("AccountingAccountTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children ChartOfAccount[] @relation("AccountingAccountTree")
  lines AccountingEntryLine[]
  debitMappings AccountingMapping[] @relation("AccountingMappingDebit")
  creditMappings AccountingMapping[] @relation("AccountingMappingCredit")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId])
  @@index([active, nature])
  @@unique([id, organizationId])
}

model AccountingPeriod {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  year Int
  month Int
  startDate DateTime
  endDate DateTime
  status String @default("ABERTO")
  closedAt DateTime?
  closedByUserId String?
  notes String?
  entries AccountingEntry[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([year, month])
  @@index([status, startDate, endDate])
  @@unique([id, organizationId])
}

model AccountingEntry {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  entryDate DateTime
  competenceDate DateTime
  description String
  sourceType String @default("MANUAL")
  sourceId String?
  originKey String? @unique
  status String @default("RASCUNHO")
  totalDebit Decimal @default(0) @db.Decimal(14,2)
  totalCredit Decimal @default(0) @db.Decimal(14,2)
  periodId String
  period AccountingPeriod? @relation(fields: [periodId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines AccountingEntryLine[]
  sourceEvent AccountingEvent?
  createdByUserId String?
  postedAt DateTime?
  reversedAt DateTime?
  reversalOfId String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([entryDate])
  @@index([competenceDate])
  @@index([periodId, status])
  @@index([sourceType, sourceId])
  @@unique([id, organizationId])
}

model AccountingEntryLine {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  entryId String
  accountId String
  lineNumber Int
  description String?
  debit Decimal @default(0) @db.Decimal(14,2)
  credit Decimal @default(0) @db.Decimal(14,2)
  referenceType String?
  referenceId String?
  entry AccountingEntry? @relation(fields: [entryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  account ChartOfAccount? @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([entryId, lineNumber])
  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
  @@unique([id, organizationId])
}

model AccountingMapping {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  eventType String
  paymentMethodId String?
  debitAccountId String
  creditAccountId String
  active Boolean @default(true)
  description String?
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId, organizationId], references: [id, organizationId], onDelete: Restrict)
  debitAccount ChartOfAccount? @relation("AccountingMappingDebit", fields: [debitAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  creditAccount ChartOfAccount? @relation("AccountingMappingCredit", fields: [creditAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventType, paymentMethodId, debitAccountId, creditAccountId])
  @@index([eventType, paymentMethodId, active])
  @@unique([id, organizationId])
}

model AccountingEvent {
  organizationId String? // Nullable during the additive multi-tenant rollout.
  id String @id @default(cuid())
  eventType String
  sourceType String
  sourceId String
  idempotencyKey String @unique
  payload Json?
  status String @default("PENDENTE")
  processedAt DateTime?
  errorMessage String?
  entryId String? @unique
  entry AccountingEntry? @relation(fields: [entryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventType, status])
  @@index([sourceType, sourceId])
  @@unique([id, organizationId])
  @@unique([entryId, organizationId])
}

