{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MB Gestão Inteligente",
  "version": "0.1.0",
  "identifier": "br.com.mboptica.gestao",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MB Gestão Inteligente",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "url": "http://127.0.0.1:3000/"
      }
    ],
    "security": {
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "MB Gestão Inteligente — servidor local independente",
    "longDescription": "Instalação local independente do MB Gestão, com banco PostgreSQL nativo e sem Docker.",
    "category": "Business"
  }
}
